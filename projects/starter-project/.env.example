# Copy this file to .env and fill in real values.
# .env is git-ignored and read by docker-compose.

# ---- Backend (FastAPI, port 3003) ----
PORT=3003
LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173

# ---- LLM provider credentials ----
# Currently the frontend passes provider config per-request; these are
# placeholders for server-side configuration / future use.
ANTHROPIC_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here
OLLAMA_BASE_URL=http://localhost:11434
MANUS_API_KEY=your_key_here

# ---- Proxy server (Node, container port 3001 -> host 3456) ----
# DEBUG=true enables verbose proxy logging
DEBUG=

# ---- Frontend (Vite, port 5173) ----
# NOTE: web/src/App.jsx currently hardcodes API_BASE="http://localhost:3003".
# To make this configurable, change it to import.meta.env.VITE_API_URL.
VITE_API_URL=http://localhost:3003
